{
  "concurrency": 1,
  "claudePath": "claude",
  "limits": {
    "runTimeoutSec": 1800,
    "runMaxBudgetUsd": 5,
    "maxReviewRounds": 3,
    "pauseAtUtilization": 0.95
  },
  "review": {
    "audit": true
  },
  "sandbox": {
    "allowedDomains": [
      "registry.npmjs.org"
    ]
  },
  "roles": {
    "planner": {
      "model": "opus"
    }
  },
  "editor": "code",
  "notify": true
}
