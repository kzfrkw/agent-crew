{
  "name": "agent-crew",
  "version": "0.1.0",
  "private": true,
  "description": "役割別のAIエージェントにローカルで開発を進めさせる基盤ツール",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-crew": "bin/agent-crew.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p gui",
    "check": "npm run typecheck && npm test",
    "build:gui": "vite build --config gui/vite.config.ts",
    "dev:gui": "vite --config gui/vite.config.ts",
    "prepare": "npm run build:gui",
    "e2e": "node scripts/e2e.ts",
    "e2e:multi": "node scripts/e2e-multi.ts",
    "e2e:mobile": "node scripts/e2e-mobile.ts",
    "e2e:ios": "node scripts/e2e-ios.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
